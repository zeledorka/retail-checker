# AI Courtroom: environment variables. Copy to ai-courtroom/.env (git-ignored) and fill in.
# On Vercel, add the same names under Project Settings -> Environment Variables (the Next.js app reads ONLY
# ai-courtroom/.env locally and Vercel env vars when deployed; ai/.env and scenarios/.env are NOT read by the app).
# [required] = the app or a live round fails without it. [optional] = has a safe default (shown).

# ---------------------------------------------------------------- Supabase
# [required] Project URL, e.g. https://<project-ref>.supabase.co  (public, bundled into the browser at BUILD time)
NEXT_PUBLIC_SUPABASE_URL=
# [required] Publishable key, sb_publishable_...  (public; browser anonymous sign-in)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [required] Secret key, sb_secret_...  (SERVER ONLY: bypasses RLS; used by every API route)
SUPABASE_SECRET_KEY=
# [local scripts only] Postgres URL for scripts/dev/db.ts (migrations/verification). Not needed on Vercel.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ---------------------------------------------------------------- Admin
# [required] Shared secret the host sends as the x-admin-secret header to /api/admin/*. Long random string.
ADMIN_SECRET=

# ---------------------------------------------------------------- Live AI (debate agents + judge)
# [required for live] "live" = real model calls. Anything else (or unset) = mock AI, no key, no cost.
AI_MODE=
# [required when AI_MODE=live with the default Anthropic roles] sk-ant-...  (read by ai/src/providers.ts)
ANTHROPIC_API_KEY=
# [optional] sk-or-v1-...  Needed only if a role below uses provider "openrouter", or for scenario images.
OPENROUTER_API_KEY=

# [optional] Per-role model. Default for every role when unset: anthropic / claude-sonnet-5-5 / effort low.
# PROVIDER = anthropic | openrouter. A non-claude MODEL requires an explicit PROVIDER.
# AGENT_A_PROVIDER=anthropic
# AGENT_A_MODEL=claude-sonnet-5-5
# AGENT_B_PROVIDER=anthropic
# AGENT_B_MODEL=claude-sonnet-5-5
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-5-5
# [optional] Anthropic effort per role: low | medium | high (default low)
# AGENT_A_EFFORT=low
# AGENT_B_EFFORT=low
# JUDGE_EFFORT=low
# [optional] Limits per role (defaults: agents 4096 tokens / 25000 ms, judge 2500 tokens / 40000 ms)
# AGENT_A_MAX_TOKENS=4096
# AGENT_A_TIMEOUT_MS=25000
# AGENT_B_MAX_TOKENS=4096
# AGENT_B_TIMEOUT_MS=25000
# JUDGE_MAX_TOKENS=2500
# JUDGE_TIMEOUT_MS=40000
# [optional] SDK retries on timeout/429/5xx (default 1). Per-role override: AGENT_A_MAX_RETRIES, AGENT_B_MAX_RETRIES, JUDGE_MAX_RETRIES.
# On Vercel keep the judge at 0 retries: 40 s timeout x 2 attempts exceeds the routes' maxDuration = 60.
# AI_MAX_RETRIES=1
# JUDGE_MAX_RETRIES=0
# [optional] OpenRouter-only per-role tuning
# JUDGE_REASONING=none          # none|minimal|low|medium|high
# JUDGE_ROUTE_SORT=latency      # latency|throughput|price

# [optional] Game tuning (defaults shown)
# AI_ARGUMENT_MAX_WORDS=70
# AI_TURN_MAX_WORDS=45
# AI_JUDGE_PARSE_RETRIES=1
# AI_MAX_INJECTIONS_PER_AGENT=3
# AI_INJECTION_MAX_CHARS=200
# AI_INJECTION_BATCH_CHARS=10000
# AI_INJECTION_BATCH_MAX_MESSAGES=200
# AI_INJECTION_MAX_PER_PLAYER=2

# [optional] Separate audience-theme reconciler. OFF by default (grouping happens inside each agent turn).
# THEMES_ENABLED=false
# THEMES_PROVIDER=anthropic
# THEMES_MODEL=claude-sonnet-5-5
# THEMES_EFFORT=low
# THEMES_MAX_TOKENS=1500
# THEMES_TIMEOUT_MS=20000
# AI_THEME_BRIEFING_THEMES=200
# AI_THEME_BRIEFING_CHARS=20000
# AI_THEME_MAX_NEW_PER_REQUEST=40
# AI_THEME_MAX_EXISTING_PER_REQUEST=30
# AI_THEME_MAX_REQUESTS=2
# AI_THEME_DEADLINE_MS=20000

# ---------------------------------------------------------------- Case generation (scripts/cases/generate-cases.ts, LOCAL ONLY)
# Not used by the app at runtime. Needs: NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY (above),
# ANTHROPIC_API_KEY (scenario writer, opinions, checker) and OPENROUTER_API_KEY (images).
# Text models are hard-coded (claude-sonnet-5-5, effort low) in scenarios/src/*.ts; there is no env override.
# [optional] Image model for the OpenRouter Images API. Default: google/gemini-3.1-flash-lite-image
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# [optional] Public Supabase Storage bucket for case images (created by the script if missing). Default: case-images
# CASE_IMAGES_BUCKET=case-images

# ---------------------------------------------------------------- Dev-only / test (never set on Vercel)
# BASE_URL=http://localhost:3000   # scripts/dev/autopilot.ts and simulate.ts target
# MOCK_AI_DELAY_MS=800             # mock AI latency
# MOCK_JUDGE_FAIL=1                # force mock judge failures (simulate.ts --judge-fail)
