NEXT_PUBLIC_USE_MOCK=1
# Real backend (only needed when NEXT_PUBLIC_USE_MOCK=0). Publishable key is safe to expose; NEVER put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the URL players should open (QR + 'join at' text on the projector). Defaults to <projector origin>/play.
# Set it when the projector runs on a different host than players use, e.g. https://your-app.vercel.app/play
NEXT_PUBLIC_JOIN_URL=
