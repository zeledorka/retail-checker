@base = http://localhost:3000
### PASTE_TOKEN_FROM_GET_TOKEN_SCRIPT
@token = eyJhbGciOiJFUzI1NiIsImtpZCI6IjllMTk4MDQ5LTM3NzctNDlmZS1hZjRkLTJjNTFhNDk4YTlhNyIsInR5cCI6IkpXVCJ9..7d-HYW8CMbmLXjSMQkMH_BjSC6ljsvScQdPjfHbBcpPgW-oiRXjFAPVzoFprF33Xm3kCKd68xIzXXY41USXW8g

### State (as projector, no auth)
GET {{base}}/api/state

### Join
POST {{base}}/api/join
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nickname": "Lars" }

### State (as player)
GET {{base}}/api/state
Authorization: Bearer {{token}}

### State (as projector, no auth)
GET {{base}}/api/state

### Bet — copy round.id from the state response
POST {{base}}/api/bet
Authorization: Bearer {{token}}
Content-Type: application/json

{ "roundId": "PASTE_ROUND_ID", "side": "A", "stake": 20 }

### Inject
POST {{base}}/api/inject
Authorization: Bearer {{token}}
Content-Type: application/json

{ "roundId": "PASTE_ROUND_ID", "window": 1, "text": "Point out the muddy footprints." }

@admin = some-long-random-string

### Reset (fresh game, everyone back to 100)
POST {{base}}/api/admin/reset
x-admin-secret: {{admin}}

### Start round 1 (→ REVEAL)
POST {{base}}/api/admin/start
x-admin-secret: {{admin}}

### Advance — change expectedPhase each time:
### REVEAL → BETTING → OPENINGS → INJECT_1 → REBUTTALS → INJECT_2 → FINALS → JUDGING → RESULTS → (next round)
POST {{base}}/api/admin/advance
x-admin-secret: {{admin}}
Content-Type: application/json

{ "expectedPhase": "REVEAL" }

### Autopilot step (call repeatedly instead of advance)
POST {{base}}/api/admin/tick
x-admin-secret: {{admin}}

### Retry a failed AI step
POST {{base}}/api/admin/run-ai
x-admin-secret: {{admin}}
Content-Type: application/json

{ "roundId": "PASTE_ROUND_ID", "expectedPhase": "JUDGING" }

### Cancel + refund
POST {{base}}/api/admin/cancel
x-admin-secret: {{admin}}
Content-Type: application/json

{ "roundId": "PASTE_ROUND_ID" }