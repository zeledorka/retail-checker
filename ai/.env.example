# Copy to ai/.env (never commit it). Next.js reads the same variables from its own .env.local.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Each role: PROVIDER = anthropic | openrouter, MODEL = exact provider model id (required, no default).
# DEFAULT (nothing set): every role is Claude Sonnet 5.5 on Anthropic at low effort (AGENT_*_EFFORT / JUDGE_EFFORT = low).
# This is the setup validated in the 200-player benchmark. Every role is configured separately; a configured model is used
# exactly as given and is never silently replaced. Lines below are only needed to CHANGE a role, e.g. a Haiku comparison:
# AGENT_A_MODEL=claude-haiku-5-5
# AGENT_B_MODEL=claude-haiku-5-5   (give AGENT_*_MAX_TOKENS=4096 for Haiku: its thinking tokens count toward the cap)
AGENT_A_PROVIDER=anthropic
AGENT_A_MODEL=claude-sonnet-5-5
AGENT_B_PROVIDER=anthropic
AGENT_B_MODEL=claude-sonnet-5-5
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5-5
# Mixed providers also work, e.g. Agent B on OpenRouter (check ids at https://openrouter.ai/models):
# AGENT_B_PROVIDER=openrouter
# AGENT_B_MODEL=deepseek/deepseek-chat

# Optional per-role tuning (defaults shown). EFFORT applies to Anthropic only: low | medium | high.
AGENT_A_EFFORT=low
AGENT_B_EFFORT=low
JUDGE_EFFORT=low
# AGENT_A_MAX_TOKENS=1024
# AGENT_A_TIMEOUT_MS=25000
# JUDGE_MAX_TOKENS=2048
# JUDGE_TIMEOUT_MS=40000
# AI_MAX_RETRIES=1

# Game tuning
# AI_ARGUMENT_MAX_WORDS=70
# AI_MAX_INJECTIONS_PER_AGENT=3
# AI_INJECTION_MAX_CHARS=200
# Sequential turns audience batching (every eligible submission is included or queued, never dropped):
# AI_INJECTION_BATCH_CHARS=10000
# AI_INJECTION_BATCH_MAX_MESSAGES=200
# AI_INJECTION_MAX_PER_PLAYER=2
# AI_JUDGE_PARSE_RETRIES=1
# AI_TURN_MAX_WORDS=45

# OpenRouter latency options per role (same model, no silent model change):
# JUDGE_REASONING=none        none|minimal|low|medium|high (rejected by models that mandate reasoning)
# JUDGE_ROUTE_SORT=latency    latency|throughput|price (picks the fastest endpoint for the same model)

# Semantic grouping of audience themes is ON by default: it reuses the first Anthropic role (agent A, agent B, judge)
# and ANTHROPIC_API_KEY. Everything below is optional.
# THEMES_ENABLED=false          # opt out (debugging / cost-controlled tests)
# THEMES_MODEL=claude-sonnet-5-5   # override the model (provider defaults to anthropic)
# THEMES_PROVIDER=anthropic
# THEMES_EFFORT=low
# THEMES_MAX_TOKENS=1500
# THEMES_TIMEOUT_MS=20000
# AI_THEME_BRIEFING_THEMES=8
# AI_THEME_BRIEFING_CHARS=20000
# AI_THEME_MAX_NEW_PER_REQUEST=40
# AI_THEME_MAX_EXISTING_PER_REQUEST=30
# AI_THEME_MAX_REQUESTS=2
# AI_THEME_DEADLINE_MS=20000
