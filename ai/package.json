    "test:openings": "tsx scripts/test-deepseek-openings.ts",
    "test:opinions": "tsx scripts/test-independent-opinions.ts",
    "test:personas": "tsx scripts/test-persona-opinions.ts",
    "test:injections": "tsx scripts/test-audience-injections.ts",
    "test:debate": "tsx scripts/test-full-debate.ts",
    "test:sequential": "tsx scripts/test-sequential-debate.ts",
    "test:judge-consistency": "tsx scripts/test-judge-consistency.ts",
    "test:all-claude": "tsx scripts/test-all-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "openai": "^7.62.0",
    "zod": "^4.6.7"
