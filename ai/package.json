{
  "name": "ai-courtroom-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Courtroom debate engine: dual agents + independent judge (Anthropic / OpenRouter).",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
