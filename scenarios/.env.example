# Copy the variables you need into your own (git-ignored) env file, e.g. ai/.env. Never commit real keys.
# Claude Sonnet 5.5: scenario writer, opinion agents and the blind checker
ANTHROPIC_API_KEY=
# OpenRouter: scenario images (Images API, POST https://openrouter.ai/api/v1/images)
OPENROUTER_API_KEY=
# Optional. Default: google/gemini-3.1-flash-lite-image (Nano Banana 2 Lite). Never replaced silently if unavailable.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
